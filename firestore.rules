
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      // Profiles are publicly readable for discovery
      allow read: if true;
      // Users can only manage their own profile data
      allow write: if isOwner(userId);
    }

    match /posts/{postId} {
      // All masterpieces are publicly discoverable (get and list)
      allow read: if true;
      
      // Only signed-in users can create posts, and they must own them
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      
      // Owners can update/delete their work; anyone can increment likes via specific update field
      allow update: if isSignedIn() && (
        isOwner(resource.data.userId) || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount'])
      );
      
      allow delete: if isOwner(resource.data.userId);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isOwner(resource.data.userId);
      }

      match /likes/{likerId} {
        allow read: if true;
        allow write: if isOwner(likerId);
      }
    }
  }
}
